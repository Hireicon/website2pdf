# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pagesnap
DB_USER=pagesnap
DB_PASSWORD=pagesnap_dev
DB_POOL_MAX=10

# ── Auth ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_random_32_char_string_min
JWT_REFRESH_SECRET=change_this_to_a_different_32_char_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For R2 (production):
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=pagesnap-pdfs
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ── Email (optional for MVP) ────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@pagesnap.app

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
